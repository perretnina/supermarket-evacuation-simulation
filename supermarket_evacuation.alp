			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[AreaNode<?>]]></ReturnType>
					<Id>1791404766469</Id>
					<Name><![CDATA[choisirZoneClients]]></Name>
					<X>240</X><Y>1060</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[
int n = uniform_discr(0, 7);

if (config.equals("A")) {
    switch (n) {
        case 0: return zoneClients0;
        case 1: return zoneClients1;
        case 2: return zoneClients2;
        case 3: return zoneClients3;
        case 4: return zoneClients4;
        case 5: return zoneClients5;
        case 6: return zoneClients6;
        default: return zoneClients7;
    }
}

if (config.equals("B")) {
    switch (n) {
        case 0: return zoneClients8;
        case 1: return zoneClients9;
        case 2: return zoneClients10;
        case 3: return zoneClients11;
        case 4: return zoneClients12;
        case 5: return zoneClients13;
        case 6: return zoneClients14;
        default: return zoneClients15;
    }
}

if (config.equals("C")) {
    switch (n) {
        case 0: return zoneClients16;
        case 1: return zoneClients17;
        case 2: return zoneClients18;
        case 3: return zoneClients19;
        case 4: return zoneClients20;
        case 5: return zoneClients21;
        case 6: return zoneClients22;
        default: return zoneClients23;
    }
}

throw new IllegalArgumentException("Configuration inconnue : " + config);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[TargetLine[]]]></ReturnType>
					<Id>1792263760298</Id>
					<Name><![CDATA[sortiesActives]]></Name>
					<X>240</X><Y>1110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[
if (config.equals("A")) {
    return new TargetLine[] { SortieA1, SortieA2 };
}

if (config.equals("B")) {
    return new TargetLine[] { SortieB1, SortieB2, SortieB3 };
}

if (config.equals("C")) {
    return new TargetLine[] { SortieC1, SortieC2, SortieC3 };
}

throw new IllegalArgumentException("Configuration inconnue : " + config);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean[]]]></ReturnType>
					<Id>1792600000001</Id>
					<Name><![CDATA[sortiesAccessibles]]></Name>
					<X>240</X><Y>1150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Une sortie est INACCESSIBLE quand la zone de danger touche la porte
// (énoncé, section 7). Zone de danger = feu + fumée (sections 4, 6 et 10).
// Les deux cercles ont le même centre : on prend donc le plus grand des deux
// rayons (en pratique toujours celui de la fumée).
// Renvoie un tableau dans le même ordre que sortiesActives().

// Rayons en pixels (10 px = 1 m) : R = R0 + v * t
double rayonFeu = (rayonInitialFeu + vitessePropagationFeu * time()) * 10;
double rayonFumee = (rayonInitialFumee + vitessePropagationFumee * time()) * 10;
double rayonDanger = Math.max(rayonFeu, rayonFumee);

// Centre du feu et extrémités de chaque porte {x1, y1, x2, y2}, en pixels.
// ATTENTION : à mettre à jour si on déplace une porte ou le feu.
double cx, cy;
double[][] portes;

switch (config) {
    case "A":
        cx = 480;  cy = 220;
        portes = new double[][] {
            {510, 285, 510, 300},     // SortieA1 (droite)
            {370, 390, 385, 390}      // SortieA2 (bas)
        };
        break;
    case "B":
        cx = 1710; cy = 140;
        portes = new double[][] {
            {1740, 205, 1740, 215},   // SortieB1 (droite)
            {1600, 310, 1610, 310},   // SortieB2 (bas)
            {1440, 205, 1440, 215}    // SortieB3 (gauche)
        };
        break;
    case "C":
        cx = 2840; cy = 150;
        portes = new double[][] {
            {2870, 215, 2870, 230},   // SortieC1 (droite)
            {2730, 320, 2745, 320},   // SortieC2 (bas)
            {2570, 215, 2570, 230}    // SortieC3 (gauche)
        };
        break;
    default:
        throw new IllegalArgumentException("Configuration inconnue : " + config);
}

boolean[] accessible = new boolean[portes.length];

for (int i = 0; i < portes.length; i++) {
    double x1 = portes[i][0], y1 = portes[i][1];
    double x2 = portes[i][2], y2 = portes[i][3];

    // Point de la porte le plus proche du centre du feu (et de la fumée)
    double dx = x2 - x1, dy = y2 - y1;
    double t = ((cx - x1) * dx + (cy - y1) * dy) / (dx * dx + dy * dy);
    t = Math.max(0, Math.min(1, t));
    double px = x1 + t * dx;
    double py = y1 + t * dy;

    double distance = Math.sqrt((cx - px) * (cx - px) + (cy - py) * (cy - py));

    accessible[i] = distance > rayonDanger;
}

return accessible;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1792600000002</Id>
					<Name><![CDATA[texteSortiesBloquees]]></Name>
					<X>240</X><Y>1190</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[boolean[] acc = sortiesAccessibles();
String bloquees = "";
for (int i = 0; i < acc.length; i++) {
    if (!acc[i]) bloquees += (bloquees.isEmpty() ? "" : ", ") + "sortie " + (i + 1);
}
return bloquees.isEmpty() ? "aucune" : bloquees;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1793000000020</Id>
					<Name><![CDATA[ecrireResultats]]></Name>
					<X>240</X><Y>1230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Écrit une ligne de résultats dans resultats.csv (dossier du modèle),
// une seule fois par simulation, si exporterResultats vaut true.
if (!exporterResultats || resultatsEcrits) return false;
resultatsEcrits = true;

int n = nbPersonnesTotal;
int evac = nbEvacues;

// Exposition de toutes les personnes (évacuées + encore présentes)
double expoTotale = sommeExposition;
for (Person p : people) expoTotale += p.exposition;
double expoMoyenne = (n > 0) ? expoTotale / n : 0;

double tIndivMoyen = (evac > 0) ? sommeTempsEvacuation / evac : -1;
int ev300 = (nbEvacues300 >= 0) ? nbEvacues300 : evac;
int ev600 = (nbEvacues600 >= 0) ? nbEvacues600 : evac;
int presents600 = n - ev600;

double m = nbMesuresCongestion;
double congMoy1 = (m > 0) ? sommeCongestion1 / m : 0;
double congMoy2 = (m > 0) ? sommeCongestion2 / m : 0;
double congMoy3 = (m > 0) ? sommeCongestion3 / m : 0;

double part1 = (evac > 0) ? (double) nbEvacuesSortie1 / evac : 0;
double part2 = (evac > 0) ? (double) nbEvacuesSortie2 / evac : 0;
double part3 = (evac > 0) ? (double) nbEvacuesSortie3 / evac : 0;

// T90 et T100 valent -1 s'ils ne sont pas atteints
String ligne = String.join(",",
    config, String.valueOf(n), strategieEvacuation,
    String.valueOf(alpha), String.valueOf(delaiAlarme), String.valueOf(vitessePropagationFumee),
    String.valueOf(graine),
    String.valueOf(tempsEvacuation90), String.valueOf(tempsEvacuationTotal),
    String.valueOf(evac), String.valueOf(ev300), String.valueOf(ev600),
    String.valueOf(presents600), String.valueOf(nbPersonnesEnDanger),
    String.valueOf(expoMoyenne), String.valueOf(expositionMax),
    String.valueOf(tIndivMoyen), String.valueOf(tempsEvacuationMax),
    String.valueOf(congMoy1), String.valueOf(congMoy2), String.valueOf(congMoy3),
    String.valueOf(maxCongestion1), String.valueOf(maxCongestion2), String.valueOf(maxCongestion3),
    String.valueOf(part1), String.valueOf(part2), String.valueOf(part3),
    String.valueOf(time()));

String entete = "config,N,strategie,alpha,delaiAlarme,vitesseFumee,graine,"
    + "T90,T100,evacues,evacues300,evacues600,presents600,enDanger,"
    + "expositionMoyenne,expositionMax,tempsIndivMoyen,tempsIndivMax,"
    + "congMoy1,congMoy2,congMoy3,congMax1,congMax2,congMax3,"
    + "part1,part2,part3,tFin";

// Écriture protégée : plusieurs simulations peuvent tourner en parallèle
synchronized (Main.class) {
    java.io.File f = new java.io.File("resultats.csv");
    boolean nouveau = !f.exists() || f.length() == 0;
    try (java.io.PrintWriter out = new java.io.PrintWriter(new java.io.FileWriter(f, true))) {
        if (nouveau) out.println(entete);
        out.println(ligne);
    } catch (java.io.IOException e) {
        traceln("Erreur d'écriture de " + f.getAbsolutePath() + " : " + e.getMessage());
        return false;
    }
    traceln("Résultat écrit (config " + config + ", graine " + graine + ") dans " + f.getAbsolutePath());
}
return true;
]]></Body>
				</Function>
			</Functions>
