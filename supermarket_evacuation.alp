							<Name><![CDATA[route]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[walkInReverseDirection]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[reachTolerance]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[
ped.estEvacuee = true;

// Nombre total de personnes évacuées
nbEvacues++;

if (ped.debutEvacuation >= 0) {
    double duree = time() - ped.debutEvacuation;

    sommeTempsEvacuation += duree;
    tempsEvacuationMax = Math.max(tempsEvacuationMax, duree);
}

// Temps d'évacuation à 90 %
if (tempsEvacuation90 < 0 &&
    nbEvacues >= Math.ceil(0.9 * nbPersonnesTotal)) {
    tempsEvacuation90 = time();
}

// Temps d'évacuation total
if (tempsEvacuationTotal < 0 &&
    nbEvacues == nbPersonnesTotal) {
    tempsEvacuationTotal = time();
}

// Nombre cumulé de personnes évacuées par sortie
TargetLine[] sorties = sortiesActives();

if (ped.sortieChoisie == sorties[0]) {
    nbEvacuesSortie1++;
} else if (ped.sortieChoisie == sorties[1]) {
    nbEvacuesSortie2++;
} else if (sorties.length == 3 &&
           ped.sortieChoisie == sorties[2]) {
    nbEvacuesSortie3++;
}

// Exposition maximale observée
expositionMax = Math.max(expositionMax, ped.exposition);

// Somme des expositions des personnes évacuées
sommeExposition += ped.exposition;

// Traces pour les tests de vérification (paramètre afficherTraces)
if (afficherTraces) {
    int numSortie = 0;
    for (int i = 0; i < sorties.length; i++) {
        if (ped.sortieChoisie == sorties[i]) numSortie = i + 1;
    }
    traceln(String.format(
        "SORTIE   t = %.1f s | personne %d | sortie %d | durée de marche %.1f s | exposition %.1f s",
        time(), ped.numero, numSortie, time() - ped.debutEvacuation, ped.exposition));
}]]></Code>
							</Value>
