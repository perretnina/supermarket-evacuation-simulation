					<Color>-16777216</Color>
					<Text><![CDATA["Vers sortie 1 : " +
people.stream().filter(p -> p.sortieChoisie == Sortie1).count() +
"\nVers sortie 2 : " +
people.stream().filter(p -> p.sortieChoisie == Sortie2).count()]]></Text>
					<TextCode><![CDATA["Configuration : " + config
+ "\nTemps : " + String.format("%.1f", time()) + " s"
+ "\nPersonnes présentes : " + people.size()
+ "\nPersonnes évacuées : " + nbEvacues
+ "\nPersonnes en danger : " + nbPersonnesEnDanger
+ "\nCongestion sortie 1 : " + congestion1
+ "\nCongestion sortie 2 : " + congestion2
+ "\nCongestion sortie 3 : " + congestion3
+ "\nExposition maximale : " + String.format("%.1f", expositionMax) + " s"]]></TextCode>
					<Font>
						<Name>SansSerif</Name>
						<Size>10</Size>
						<Style>0</Style>
					</Font>
					<Alignment>LEFT</Alignment>
				</Text>
