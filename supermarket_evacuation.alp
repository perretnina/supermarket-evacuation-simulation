					</Properties>
					<Action><![CDATA[alarmeDeclenchee = true;

for (Person p : people) {
    send("ALARME", p);
}]]></Action>
				</Event>
				<Event>
					<Id>1791406426381</Id>
					<Name><![CDATA[majFumee]]></Name>
					<X>240</X><Y>1450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1791406426379</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1791446400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0.1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[0.1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// 1. Centre du feu selon la configuration
double centreX = 0;
double centreY = 0;

switch (config) {
    case "A":
        centreX = 480;
        centreY = 220;
        break;

    case "B":
        centreX = 1710;
        centreY = 140;
        break;

    case "C":
        centreX = 2840;
        centreY = 150;
        break;
}

// 2. Rayon actuel de la fumée (en mètres)
double rayonFumee = rayonInitialFumee
    + vitessePropagationFumee * time();

// 3. Mise à jour de chaque personne
for (Person p : people) {

    // Distance entre la personne et le feu (en mètres)
    double dx = (p.getX() - centreX) / 10.0;
    double dy = (p.getY() - centreY) / 10.0;

    double distance = Math.sqrt(dx * dx + dy * dy);

    // 4. Vérifier si la personne est dans la fumée
    p.dansFumee = distance <= rayonFumee;

    // 5. Exposition et ralentissement
    if (p.dansFumee) {

        p.exposition += 0.1;
        p.setComfortableSpeed(p.vitesse * 0.7);

    } else {

        p.setComfortableSpeed(p.vitesse);
    }

    // 6. Mise à jour de l'exposition maximale
    expositionMax = Math.max(expositionMax, p.exposition);

    // 7. Passage en danger
    if (p.exposition >= seuilExposition && !p.estEnDanger) {

        p.estEnDanger = true;
        nbPersonnesEnDanger++;
    }

    // 8. Fait passer la machine à états dans l'état enDanger
    // (envoyé à chaque pas : le message n'est pris en compte qu'en Evacuation)
    if (p.estEnDanger) {
        p.receive("DANGER");
    }
}

// 9. Condition d'arrêt (section 14) : tout le monde est évacué ou en danger.
// Les personnes évacuées sont retirées de people par pedSink.
if (people.stream().allMatch(p -> p.estEnDanger)) {
    if (nbEvacues300 < 0) nbEvacues300 = nbEvacues;
    if (nbEvacues600 < 0) nbEvacues600 = nbEvacues;
    ecrireResultats();
    finishSimulation();
}]]></Action>
				</Event>
				<Event>
					<Id>1791913246612</Id>
					<Name><![CDATA[majCongestion]]></Name>
