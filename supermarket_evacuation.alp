					<IconOffset>20.0</IconOffset>
					<Properties Source="1791394812688" Target="1791394812695" Trigger="timeout">
						<Action><![CDATA[// Choisir la sortie accessible au score le plus faible
// (calcul du score dans la fonction calculerScores)
double[] score = calculerScores();
int meilleure = 0;
for (int i = 1; i < score.length; i++) {
    if (score[i] < score[meilleure]) meilleure = i;
}
sortieChoisie = main.sortiesActives()[meilleure];

// Traces pour les tests de vérification (paramètre afficherTraces)
if (main.afficherTraces) {
    traceln(String.format(
        "DEPART   t = %.1f s | personne %d | vitesse %.2f m/s | réaction %.1f s | départ attendu %.1f s | sortie %d",
        time(), numero, vitesse, tempsDeReaction,
        main.delaiAlarme + tempsDeReaction, meilleure + 1));
}

// Libérer le piéton pour déclencher son évacuation
get_Main().pedWait.free(this);]]></Action>
						<Timeout Class="CodeUnitValue">
