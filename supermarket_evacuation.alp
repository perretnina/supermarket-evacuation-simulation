							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// 1. Zones de congestion (carrés jaunes de 3 x 3 m devant chaque porte)
ShapeRectangle[] zones;

switch (config) {
    case "A":
        zones = new ShapeRectangle[] { zoneCongestionA1, zoneCongestionA2 };
        break;
    case "B":
        zones = new ShapeRectangle[] { zoneCongestionB1, zoneCongestionB2, zoneCongestionB3 };
        break;
    case "C":
        zones = new ShapeRectangle[] { zoneCongestionC1, zoneCongestionC2, zoneCongestionC3 };
        break;
    default:
        zones = new ShapeRectangle[0];
}

// 2. Comptage des personnes à l'intérieur de chaque carré
int[] compteurs = new int[zones.length];

for (Person p : people) {
    double x = p.getX();
    double y = p.getY();

    for (int i = 0; i < zones.length; i++) {
        ShapeRectangle z = zones[i];
        if (x >= z.getX() && x <= z.getX() + z.getWidth()
                && y >= z.getY() && y <= z.getY() + z.getHeight()) {
            compteurs[i]++;
        }
    }
}

// 3. Congestions instantanées
congestion1 = (compteurs.length > 0) ? compteurs[0] : 0;
congestion2 = (compteurs.length > 1) ? compteurs[1] : 0;
congestion3 = (compteurs.length > 2) ? compteurs[2] : 0;

// 4. Enregistrement des mesures
nbMesuresCongestion++;

sommeCongestion1 += congestion1;
sommeCongestion2 += congestion2;
sommeCongestion3 += congestion3;

// 5. Congestions maximales
maxCongestion1 = Math.max(maxCongestion1, congestion1);
maxCongestion2 = Math.max(maxCongestion2, congestion2);
maxCongestion3 = Math.max(maxCongestion3, congestion3);]]></Action>
				</Event>
