			<Events>
				<Event>
					<Id>1791914174896</Id>
					<Name><![CDATA[reevaluerSortie]]></Name>
					<X>700</X><Y>40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1791914174894</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1791964800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[5]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// Réévaluation toutes les 5 s pendant l'évacuation
if (sortieChoisie != null && !estEvacuee) {

    TargetLine[] sorties = main.sortiesActives();
    double[] score = calculerScores();

    int actuelle = -1;
    int meilleure = 0;
    for (int i = 0; i < score.length; i++) {
        if (sorties[i] == sortieChoisie) actuelle = i;
        if (score[i] < score[meilleure]) meilleure = i;
    }

    if (actuelle >= 0 && meilleure != actuelle) {

        // 1. La sortie visée est devenue inaccessible (zone de danger) : on change,
        //    dans les deux stratégies (énoncé section 7)
        boolean bloquee = Double.isInfinite(score[actuelle]);

        // 2. Stratégie congestion : on change si une autre sortie est
        //    nettement meilleure (10 %), pour éviter les allers-retours
        boolean meilleureNette = main.strategieEvacuation.equals("Congestion")
                && score[meilleure] < score[actuelle] * 0.9;

        if (bloquee || meilleureNette) {
            if (main.afficherTraces) {
                traceln(String.format(
                    "CHANGEMENT t = %.1f s | personne %d | sortie %d -> sortie %d | raison : %s",
                    time(), numero, actuelle + 1, meilleure + 1,
                    bloquee ? "porte bloquée" : "congestion"));
            }
            sortieChoisie = sorties[meilleure];
            // Annule le déplacement en cours : le piéton repart vers la nouvelle sortie
            main.pedGoTo.cancel(this);
        }
    }
}]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1792600000004</Id>
					<Name><![CDATA[calculerScores]]></Name>
					<X>700</X><Y>90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Score de chaque sortie (énoncé, section 7) :
// score = alpha * D + (1 - alpha) * C
// D = distance / distance max, C = congestion / congestion max (entre 0 et 1),
// calculés uniquement parmi les sorties ACCESSIBLES (non touchées par la zone de danger).
// Une sortie inaccessible reçoit un score infini : elle n'est jamais choisie.
// Stratégie "Distance" = alpha égal à 1 (seule la distance compte).
TargetLine[] sorties = main.sortiesActives();
int n = sorties.length;

boolean[] accessible = main.sortiesAccessibles();
boolean auMoinsUne = false;
for (int i = 0; i < n; i++) {
    if (accessible[i]) auMoinsUne = true;
}
// Si la zone de danger bloque toutes les sorties, on les considère toutes
if (!auMoinsUne) {
    for (int i = 0; i < n; i++) accessible[i] = true;
}

double[] d = new double[n];
double[] c = new double[n];
double dMax = 0;
double cMax = 0;

for (int i = 0; i < n; i++) {
    double dx = getX() - sorties[i].getX();
    double dy = getY() - sorties[i].getY();
    d[i] = Math.sqrt(dx * dx + dy * dy);

    if (i == 0) c[i] = main.congestion1;
    if (i == 1) c[i] = main.congestion2;
    if (i == 2) c[i] = main.congestion3;

    if (accessible[i]) {
        dMax = Math.max(dMax, d[i]);
        cMax = Math.max(cMax, c[i]);
    }
}

double a = main.strategieEvacuation.equals("Distance") ? 1.0 : main.alpha;

double[] score = new double[n];
for (int i = 0; i < n; i++) {
    if (!accessible[i]) {
        score[i] = Double.POSITIVE_INFINITY;
    } else {
        double D = (dMax > 0) ? d[i] / dMax : 0;
        double C = (cMax > 0) ? c[i] / cMax : 0;
        score[i] = a * D + (1 - a) * C;
    }
}
return score;
]]></Body>
				</Function>
